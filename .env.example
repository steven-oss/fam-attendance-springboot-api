# Aiven PostgreSQL（從 Aiven Console → Connection information 複製）
POSTGRES_HOST=your-service.aivencloud.com
POSTGRES_PORT=27618
POSTGRES_DB=defaultdb
POSTGRES_USER=avnadmin
POSTGRES_PASSWORD=your-aiven-service-password
POSTGRES_SSL_MODE=require

# 本機預設 8080；Render 會自動注入 PORT（無需手動設定）
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
